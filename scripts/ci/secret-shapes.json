{
  "comment": [
    "The one set of secret candidate shapes. Read by scripts/ci/secret-scan.py",
    "(the gate scan), remuda-hub's secret_lint module (the memory write lint,",
    "main-agent.md 12.5) and remuda brief lint. Patterns use the syntax Python re",
    "and Rust fancy-regex share; group 1, when present, is the payload the",
    "redaction and minimum-length checks look at, otherwise the whole match.",
    "No pattern here matches its own text: the PEM marker spells its spaces as",
    "[ ] so this file passes the scan it defines.",
    "scripts/ci/secret-shapes-corpus.txt is the agreement corpus both sides test."
  ],
  "rules": [
    {"name": "agk_", "pattern": "(?<![A-Za-z0-9_])agk_([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "sk-", "pattern": "(?<![A-Za-z0-9_])sk-([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "Bearer ", "pattern": "(?<![A-Za-z])Bearer ([A-Za-z0-9._\\-+=/]{8,})", "minPayload": 16},
    {"name": "ANTHROPIC_AUTH_TOKEN=", "pattern": "ANTHROPIC_AUTH_TOKEN=['\"]?([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "api_key", "pattern": "\\bapi_key\\b\\s*[=:]\\s*['\"]?([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "REMUDA_BOOTSTRAP_TOKEN=", "pattern": "REMUDA_BOOTSTRAP_TOKEN=['\"]?([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "OPENAI_API_KEY=", "pattern": "OPENAI_API_KEY=['\"]?([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "xai-", "pattern": "(?<![A-Za-z0-9_])xai-([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "ghp_", "pattern": "(?<![A-Za-z0-9_])ghp_([A-Za-z0-9]{8,})", "minPayload": 16},
    {"name": "github_pat_", "pattern": "(?<![A-Za-z0-9_])github_pat_([A-Za-z0-9_]{8,})", "minPayload": 16},
    {"name": "app_secret", "pattern": "\\bapp_secret\\b\\s*[=:]\\s*['\"]?([A-Za-z0-9_\\-]{8,})", "minPayload": 16},
    {"name": "BEGIN PRIVATE KEY", "pattern": "-----BEGIN[ ]PRIVATE[ ]KEY-----", "minPayload": 0}
  ],
  "dummyPart": "(?i)(^|[-_/])(secret|example|placeholder|dummy|redacted|fake|sample|yourkey|xxx+|should-not|bootstrap|leak)([-_]|$)",
  "placeholder": "^(<[^>]+>|\\$\\{[^}]+\\}|\\$[A-Za-z_][A-Za-z0-9_]*|\\{[^}]+\\})",
  "mask": "*xX•.…][)("
}
