{
  "openapi": "3.1.0",
  "info": {
    "title": "Remuda Hub HTTP",
    "version": "0.1.0",
    "description": "Device-authenticated Hub REST and WebSocket upgrade routes. JSON-RPC over `/v1/node` and `/v1/follow` is documented as GET upgrades."
  },
  "servers": [{ "url": "/", "description": "Same origin" }],
  "tags": [
    { "name": "health" },
    { "name": "auth" },
    { "name": "hosts" },
    { "name": "instances" },
    { "name": "worktrees" },
    { "name": "fleet" },
    { "name": "devices" },
    { "name": "providers" },
    { "name": "push" },
    { "name": "realtime" }
  ],
  "paths": {
    "/v1/hosts/ssh": {
      "post": {
        "tags": [
          "hosts"
        ],
        "operationId": "hostSshAdd",
        "summary": "Persist a Hub-supervised SSH host and start preflight/reconnect",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SshHostCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Host registered; inspect state and lastError while connecting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostView"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["health"],
        "operationId": "healthz",
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "login",
        "summary": "Bootstrap token → device cookie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Device session",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DeviceSession" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/hosts/enroll-token": {
      "post": {
        "tags": ["auth"],
        "operationId": "mintEnrollToken",
        "summary": "Mint a single-use Node enroll token (D-018)",
        "description": "Requires an authenticated device. The plaintext is returned once; the Hub stores only its Argon2 hash. The device pairing access code never enrolls a Node.",
        "responses": {
          "200": {
            "description": "Enroll token",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EnrollToken" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/hosts": {
      "get": {
        "tags": ["hosts"],
        "operationId": "hostList",
        "summary": "List enrolled hosts",
        "responses": {
          "200": {
            "description": "Host page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HostPage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/hosts/{id}": {
      "delete": {
        "tags": [
          "hosts"
        ],
        "operationId": "hostRemove",
        "summary": "Remove a supervised SSH host after stopping its instances; keep journal history",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Supervisor cancelled, connection closed, registration removed; remote files retained"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "tags": ["hosts"],
        "operationId": "hostGet",
        "summary": "Host inventory",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Host",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HostView" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["hosts"],
        "operationId": "hostPatch",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/HostPatch" } }
          }
        },
        "responses": {
          "200": {
            "description": "Updated host",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HostView" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/hosts/{id}/doctor": {
      "get": {
        "tags": ["hosts"],
        "operationId": "hostDoctor",
        "summary": "Fresh diagnostics over the registered host's active Node link",
        "description": "Requires device authentication. Runs the Node inventory, data/identity, disk and listener checks without returning credentials. Login states are local-marker heuristics. RPC callers cannot choose filesystem paths.",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Host preflight, including blockers in exitCode/checks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["exitCode", "inventory", "checks"],
                  "properties": {
                    "exitCode": { "type": "integer", "enum": [0, 1] },
                    "inventory": { "type": ["object", "null"] },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "status", "message", "details"],
                        "properties": {
                          "name": { "type": "string" },
                          "status": { "type": "string", "enum": ["ok", "warning", "blocker"] },
                          "message": { "type": "string" },
                          "details": {}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/instances": {
      "get": {
        "tags": ["instances"],
        "operationId": "instanceList",
        "parameters": [
          {
            "name": "hostId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Instance page. lifecycle is derived from Node journal observations (requested→starting→running→exited/failed). activity=idle only after a herdr/Node idle observation, never the create default.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InstancePage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["instances"],
        "operationId": "instanceCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/InstanceCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InstanceCreateResult" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/instances/{id}": {
      "get": {
        "tags": ["instances"],
        "operationId": "instanceGet",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Instance",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InstanceRecord" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/instances/{id}/commands": {
      "post": {
        "tags": ["instances"],
        "operationId": "instanceCommand",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CommandRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Command ledger row",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CommandResult" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/instances/{id}/journal": {
      "get": {
        "tags": ["instances"],
        "operationId": "instanceJournal",
        "parameters": [
          { "$ref": "#/components/parameters/IdPath" },
          {
            "name": "afterSeq",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Mirrored journal",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JournalPage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/worktrees": {
      "get": {
        "tags": ["worktrees"],
        "operationId": "worktreeList",
        "summary": "List git worktrees on a host (Node remuda worktree catalog)",
        "parameters": [
          {
            "name": "hostId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Worktree page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorktreePage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["worktrees"],
        "operationId": "worktreeCreate",
        "summary": "Create a git worktree on a host (`git worktree add -b wt/<name>/…` from main) at the Node's fixed `../remuda-wt/<name>` location",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WorktreeCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Created or reused worktree",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorktreeRecord" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/placement/resolve": {
      "post": {
        "tags": ["hosts"],
        "operationId": "placementResolve",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PlacementResolve" } }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked hosts",
            "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } }
          },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/fleet/instances": {
      "post": {
        "tags": ["fleet"],
        "operationId": "fleetCreate",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FleetCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Fleet",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FleetCreateResult" } }
            }
          },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/fleet/broadcast": {
      "post": {
        "tags": ["fleet"],
        "operationId": "fleetBroadcast",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FleetBroadcast" } }
          }
        },
        "responses": {
          "200": {
            "description": "Per-instance fan-out results with an accepted/failed summary",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FleetBroadcastResult" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/fleet/{id}": {
      "get": {
        "tags": ["fleet"],
        "operationId": "fleetGet",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Fleet aggregate",
            "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/fleet/{id}/commands": {
      "post": {
        "tags": ["fleet"],
        "operationId": "fleetCommands",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CommandRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Per-instance commands",
            "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } }
          }
        }
      }
    },
    "/v1/devices": {
      "get": {
        "tags": ["devices"],
        "operationId": "deviceList",
        "responses": {
          "200": {
            "description": "Devices",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DevicePage" } }
            }
          }
        }
      }
    },
    "/v1/devices/{id}": {
      "delete": {
        "tags": ["devices"],
        "operationId": "deviceRevoke",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/devices/pair-code": {
      "post": {
        "tags": ["devices"],
        "operationId": "devicePairCode",
        "responses": {
          "200": {
            "description": "One-time code",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PairCode" } }
            }
          }
        }
      }
    },
    "/v1/devices/pair": {
      "post": {
        "tags": ["devices"],
        "operationId": "devicePairRedeem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PairRedeem" } }
          }
        },
        "responses": {
          "200": {
            "description": "New device session",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DeviceSession" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/push/config": {
      "get": {
        "tags": ["push"],
        "operationId": "pushConfig",
        "responses": {
          "200": {
            "description": "VAPID public key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["public_key"],
                  "properties": { "public_key": { "type": "string" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/push/subscriptions": {
      "post": {
        "tags": ["push"],
        "operationId": "pushSubscribe",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PushSubscribe" } }
          }
        },
        "responses": {
          "201": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["push"],
        "operationId": "pushUnsubscribe",
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/interactions": {
      "get": {
        "tags": ["instances"],
        "operationId": "interactionList",
        "summary": "Pending interactions across connected hosts",
        "parameters": [
          { "name": "hostId", "in": "query", "schema": { "type": "string" } },
          { "name": "instanceId", "in": "query", "schema": { "type": "string" } },
          { "name": "kind", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Interaction page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InteractionPage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/interactions/{id}/answer": {
      "post": {
        "tags": ["instances"],
        "operationId": "interactionAnswer",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/InteractionAnswerRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "First-answer-wins result",
            "content": {
              "application/json": { "schema": { "type": "object", "additionalProperties": true } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/providers": {
      "get": {
        "tags": ["providers"],
        "operationId": "providerList",
        "summary": "List provider profiles (secret never returned)",
        "responses": {
          "200": {
            "description": "Provider page",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProviderPage" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["providers"],
        "operationId": "providerCreate",
        "summary": "Create a gateway or direct profile; authToken stored encrypted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProviderCreate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Created profile (fingerprint/last4 only)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProviderProfile" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/providers/{id}": {
      "get": {
        "tags": ["providers"],
        "operationId": "providerGet",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProviderProfile" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["providers"],
        "operationId": "providerPatch",
        "summary": "Update metadata and/or rotate authToken",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProviderPatch" } }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProviderProfile" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["providers"],
        "operationId": "providerDelete",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/providers/{id}/test": {
      "post": {
        "tags": ["providers"],
        "operationId": "providerTest",
        "summary": "Probe models list / reachability against the gateway",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "Probe result",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProviderTestResult" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/follow": {
      "get": {
        "tags": ["realtime"],
        "operationId": "follow",
        "summary": "WebSocket snapshot + live journal",
        "parameters": [
          {
            "name": "instanceId",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": { "101": { "description": "Switching Protocols" } }
      }
    },
    "/v1/node": {
      "get": {
        "tags": ["realtime"],
        "operationId": "nodeSocket",
        "summary": "Node JSON-RPC WebSocket",
        "responses": { "101": { "description": "Switching Protocols" } }
      }
    },
    "/node/v1/connect": {
      "get": {
        "tags": ["realtime"],
        "operationId": "nodeConnectAlias",
        "summary": "Alias of /v1/node",
        "responses": { "101": { "description": "Switching Protocols" } }
      }
    }
  },
  "components": {
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Error": {
        "description": "Hub error",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
        }
      }
    },
    "schemas": {
      "SshHostCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "label"
        ],
        "properties": {
          "target": {
            "type": "string",
            "maxLength": 255,
            "description": "SSH config alias or user@host, resolved by the Hub system SSH client."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "labels": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "Placement labels such as egress:gateway or region=sg."
          },
          "remuda_binary_policy": {
            "type": "string",
            "enum": [
              "require_installed",
              "upload_if_missing"
            ],
            "default": "require_installed"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": ["error", "code"],
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["bootstrapToken"],
        "properties": {
          "bootstrapToken": { "type": "string" },
          "deviceName": { "type": "string" }
        }
      },
      "DeviceSession": {
        "type": "object",
        "required": ["deviceId", "token", "name"],
        "properties": {
          "deviceId": { "type": "string" },
          "token": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "EnrollToken": {
        "type": "object",
        "required": ["enrollTokenId", "token", "expiresAt"],
        "properties": {
          "enrollTokenId": { "type": "string" },
          "token": { "type": "string", "description": "Single-use secret; returned once." },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "Device": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "DevicePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Device" } }
        }
      },
      "PairCode": {
        "type": "object",
        "required": ["code", "expiresAt"],
        "properties": {
          "code": { "type": "string" },
          "expiresAt": { "type": "string" }
        }
      },
      "ProviderSecretView": {
        "type": "object",
        "required": ["present"],
        "properties": {
          "present": { "type": "boolean" },
          "last4": { "type": ["string", "null"] },
          "fingerprint": { "type": ["string", "null"] }
        }
      },
      "ProviderHealth": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "checkedAt": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] },
          "status": { "type": ["integer", "null"] },
          "latencyMs": { "type": ["integer", "null"] }
        }
      },
      "ProviderProfile": {
        "type": "object",
        "required": ["id", "name", "kind", "baseUrl", "models", "defaultGateway", "revision", "secret"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["gateway", "direct"] },
          "baseUrl": { "type": "string" },
          "models": { "type": "array", "items": { "type": "string" } },
          "defaultModel": { "type": ["string", "null"] },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "defaultGateway": { "type": "boolean" },
          "revision": { "type": "string" },
          "secret": { "$ref": "#/components/schemas/ProviderSecretView" },
          "health": { "oneOf": [{ "$ref": "#/components/schemas/ProviderHealth" }, { "type": "null" }] },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "ProviderPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ProviderProfile" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "ProviderCreate": {
        "type": "object",
        "required": ["name", "authToken"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["gateway", "direct"] },
          "baseUrl": { "type": "string" },
          "models": { "type": "array", "items": { "type": "string" } },
          "defaultModel": { "type": "string" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "authToken": { "type": "string" },
          "defaultGateway": { "type": "boolean" }
        }
      },
      "ProviderPatch": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["gateway", "direct"] },
          "baseUrl": { "type": "string" },
          "models": { "type": "array", "items": { "type": "string" } },
          "defaultModel": { "type": ["string", "null"] },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "authToken": { "type": "string", "description": "Rotate the stored token." },
          "defaultGateway": { "type": "boolean" }
        }
      },
      "ProviderTestResult": {
        "type": "object",
        "required": ["ok", "reachable", "message"],
        "properties": {
          "ok": { "type": "boolean" },
          "reachable": { "type": "boolean" },
          "status": { "type": ["integer", "null"] },
          "latencyMs": { "type": "integer" },
          "message": { "type": "string" },
          "models": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PairRedeem": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "deviceName": { "type": "string" }
        }
      },
      "HostCli": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "auth": {
            "type": "string",
            "enum": ["logged_in", "logged_out", "unknown", "gateway-native", "none"]
          },
          "installed": { "type": "boolean" },
          "nativeGateway": { "type": "boolean" }
        }
      },
      "HostView": {
        "type": "object",
        "additionalProperties": true,
        "required": ["hostId", "label", "state", "online"],
        "properties": {
          "ssh": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "target",
              "remudaBinaryPolicy"
            ],
            "properties": {
              "workspaceRoot": { "type": "string" },
              "target": {
                "type": "string"
              },
              "remudaBinaryPolicy": {
                "type": "string",
                "enum": [
                  "require_installed",
                  "upload_if_missing"
                ],
                "default": "require_installed"
              }
            }
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostId": { "type": "string", "description": "Stable Node identity (`hst_…`)." },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "state": { "type": "string" },
          "online": { "type": "boolean" },
          "lastSeenAt": { "type": ["string", "null"] },
          "nodeVersion": { "type": ["string", "null"] },
          "cli": { "type": "array", "items": { "$ref": "#/components/schemas/HostCli" } },
          "capabilities": { "type": "object", "additionalProperties": true },
          "labels": { "type": "array", "items": { "type": "string" } },
          "herdr": { "type": ["object", "null"], "additionalProperties": true },
          "resources": { "type": ["object", "null"], "additionalProperties": true },
          "maxInstances": { "type": "integer" },
          "instanceCount": { "type": "integer" },
          "transport": { "type": "string" },
          "hostname": { "type": ["string", "null"] }
        }
      },
      "HostPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/HostView" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "HostPatch": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "maxInstances": { "type": "integer" }
        }
      },
      "InstanceRecord": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "instanceId",
          "hostId",
          "kind",
          "driver",
          "lifecycle",
          "activity",
          "connectivity",
          "journalId",
          "durableSeq"
        ],
        "properties": {
          "instanceId": { "type": "string" },
          "hostId": { "type": "string" },
          "workspaceId": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "driver": { "type": "string" },
          "lifecycle": {
            "type": "string",
            "enum": ["requested", "starting", "running", "closing", "exited", "failed"],
            "description": "Derived from Node lifecycle observations in journal.append. Create default is requested, not running."
          },
          "activity": {
            "type": "string",
            "enum": ["unknown", "idle", "working", "blocked", "draining"],
            "description": "idle only after a Node/herdr agent_status or session idle observation. Create default is unknown."
          },
          "connectivity": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "cwd": { "type": ["string", "null"] },
          "delegation": { "type": ["string", "null"] },
          "providerProfileId": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "effortName": { "type": ["string", "null"] },
          "effortIndex": { "type": ["integer", "null"] },
          "journalId": { "type": "string" },
          "durableSeq": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "InstancePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/InstanceRecord" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "InstanceCreate": {
        "type": "object",
        "properties": {
          "hostId": { "type": "string" },
          "workspaceId": { "type": "string" },
          "kind": { "type": "string" },
          "driver": { "type": "string" },
          "title": { "type": "string" },
          "prompt": { "type": "string" },
          "placement": { "type": "object", "additionalProperties": true },
          "delegation": { "type": "string" },
          "model": { "type": "string" },
          "providerProfileId": { "type": "string" },
          "permissionMode": { "type": "string" },
          "name": { "type": "string" },
          "cwd": { "type": "string", "description": "Working directory on the host." },
          "worktree": { "type": "string", "description": "Worktree name created by remuda worktree create." },
          "settingsOverlayPath": { "type": "string" },
          "claudeConfigDir": { "type": "string" },
          "maxBudgetUsd": { "type": ["string", "number"] }
        }
      },
      "WorktreeCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "hostId": { "type": "string" },
          "name": { "type": "string" },
          "base": { "type": "string", "description": "Start-point (default main)." }
        }
      },
      "WorktreeRecord": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "branch": { "type": "string" },
          "base": { "type": "string" },
          "hostId": { "type": "string" },
          "workspaceRoot": { "type": "string" }
        }
      },
      "WorktreePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/WorktreeRecord" } },
          "hostId": { "type": "string" },
          "workspaceRoot": { "type": ["string", "null"] },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "CommandRecord": {
        "type": "object",
        "additionalProperties": true,
        "required": ["commandId", "hostId", "operation", "state"],
        "properties": {
          "commandId": { "type": "string" },
          "instanceId": { "type": ["string", "null"] },
          "hostId": { "type": "string" },
          "operation": { "type": "string" },
          "state": { "type": "string" },
          "resolution": { "type": "string" },
          "forwarded": { "type": "boolean" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "InstanceCreateResult": {
        "type": "object",
        "required": ["instance", "command"],
        "properties": {
          "instance": { "$ref": "#/components/schemas/InstanceRecord" },
          "command": { "$ref": "#/components/schemas/CommandRecord" },
          "hostId": { "type": "string" }
        }
      },
      "CommandRequest": {
        "type": "object",
        "properties": {
          "commandId": { "type": "string" },
          "operation": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true },
          "idempotencyKey": { "type": "string" },
          "prompt": { "type": "string" }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": { "$ref": "#/components/schemas/CommandRecord" },
          "replayed": { "type": "boolean" }
        }
      },
      "InteractionPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "InteractionAnswerRequest": {
        "type": "object",
        "required": ["answer"],
        "properties": {
          "commandId": { "type": "string" },
          "answer": { "type": "object", "additionalProperties": true }
        }
      },
      "JournalPage": {
        "type": "object",
        "required": ["instanceId", "durableSeq", "events"],
        "properties": {
          "instanceId": { "type": "string" },
          "durableSeq": { "type": "string" },
          "events": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "PlacementResolve": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "hostId": { "type": "string" },
          "placement": { "type": "object", "additionalProperties": true },
          "driver": { "type": "string" },
          "delegation": { "type": "string" }
        }
      },
      "FleetCreate": {
        "type": "object",
        "properties": {
          "spec": { "type": "object", "additionalProperties": true },
          "hosts": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "max": { "type": "integer" },
          "kind": { "type": "string" },
          "driver": { "type": "string" },
          "prompt": { "type": "string" }
        }
      },
      "FleetCreateResult": {
        "type": "object",
        "properties": {
          "fleetId": { "type": "string" },
          "instanceIds": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FleetBroadcast": {
        "type": "object",
        "description": "Select running instances and fan one command out. Requires `all` or at least one of `hosts` / `labels` / `kinds`; filters intersect.",
        "properties": {
          "all": { "type": "boolean" },
          "hosts": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "kinds": { "type": "array", "items": { "type": "string" } },
          "operation": { "type": "string", "enum": ["instance.send", "tty.write"] },
          "payload": { "type": "object", "additionalProperties": true },
          "idempotencyKey": {
            "type": "string",
            "description": "Base key; each instance is queued under `<key>:<instanceId>` so a retry replays instead of double-sending."
          }
        }
      },
      "FleetBroadcastResult": {
        "type": "object",
        "properties": {
          "operation": { "type": "string" },
          "accepted": { "type": "integer" },
          "failed": { "type": "integer" },
          "skipped": { "type": "integer" },
          "selected": { "type": "integer" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instanceId": { "type": "string" },
                "hostId": { "type": "string" },
                "kind": { "type": "string" },
                "ok": { "type": "boolean" },
                "commandId": { "type": "string" },
                "state": { "type": "string" },
                "resolution": { "type": ["string", "null"] },
                "forwarded": { "type": "boolean" },
                "replayed": { "type": "boolean" },
                "error": { "type": "string" }
              }
            }
          }
        }
      },
      "PushSubscribe": {
        "type": "object",
        "required": ["endpoint", "keys"],
        "properties": {
          "endpoint": { "type": "string" },
          "keys": {
            "type": "object",
            "required": ["p256dh", "auth"],
            "properties": {
              "p256dh": { "type": "string" },
              "auth": { "type": "string" }
            }
          },
          "deviceId": { "type": "string" }
        }
      }
    }
  }
}
