# Copy to .env; values are literal, unquoted, with no whitespace/interpolation.
HUB_DOMAIN=<hub-host>
ACME_EMAIL=ops@<zone>
# Registry image with an explicit release tag, or the locally imported M1 tag.
HUB_IMAGE=remuda-hub:<sha>
CADDY_IMAGE=caddy:2-alpine
COMPOSE_PROJECT_NAME=remuda-public
DATA_DIR=/var/lib/remuda-public
BACKUP_DIR=/var/backups/remuda-public
# age public recipient only; retain the corresponding identity OFF the VPS.
BACKUP_RECIPIENT=
# Optional for directly addressed VPSs; required for provider NAT mappings.
VPS_PUBLIC_IP=
# Synthetic private Docker bridge defaults. Change together on address conflict.
PROXY_SUBNET=172.30.19.0/24
PROXY_IP=172.30.19.2
